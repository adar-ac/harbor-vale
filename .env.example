# Copy to .env and fill in. Never commit .env.
# Crew 1 (analyst) uses Gemini. Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional override; default is gemini/gemini-3.8-flash
# MODEL=gemini/gemini-3.8-flash

# Keep CrewAI from sending traces/telemetry (both read by crewai 1.15.23).
CREWAI_TRACING_ENABLED=false
OTEL_SDK_DISABLED=true
