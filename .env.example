# Copy to .env and fill in. Never commit .env.
# Both crews use OpenAI. Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Optional override; default is openai/gpt-4o-mini.
# Gemini fallback (free key at https://aistudio.google.com/apikey); the free tier
# allows only a few requests/min, so expect rate-limit retries:
# MODEL=gemini/gemini-3.6-flash
# GEMINI_API_KEY=

# Run both crews' deterministic tools only (telco.csv -> crew1 + crew2 artifacts); no LLM / agents.
# ANALYST_DRYRUN=1

# Keep CrewAI from sending traces/telemetry (both read by crewai 1.15.23).
CREWAI_TRACING_ENABLED=false
OTEL_SDK_DISABLED=true
